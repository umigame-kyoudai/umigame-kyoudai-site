{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umigame-kyoudai-site",
  "account_id": "6ee1007b5398ed60a4eb9a43407d0a56",
  "main": "cloudflare-production-worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": { "CF_WORKER_DEPLOYMENT": "1" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "rate-limiter-v1", "new_sqlite_classes": ["RateLimiter"] }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "umigame-kyoudai-site" }]
}
